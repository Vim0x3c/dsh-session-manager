# The plugin's peers are @deepseek-ai/dsh-* packages that are not published to
# npm; the dsh profile's module fallback resolves them from the dsh application
# closure at runtime. Never auto-install peers (pnpm would 404), and never fail
# the install on missing peers (they are not supposed to be installed here).
auto-install-peers=false
strict-peer-dependencies=false
