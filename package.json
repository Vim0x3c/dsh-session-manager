{
  "name": "dsh-session-manager",
  "version": "0.1.1",
  "description": "Session management settings section for dsh web: resume, outline, and delete any session",
  "author": "vim0x3c",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vim0x3c/dsh-session-manager.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "session",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "pack": "pnpm build && pnpm pack"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
